# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit or share the real .env file.

# From the EMQX Cloud console: deployment Overview -> Connection Information -> Address
MQTT_HOST=paste-your-deployment-address-here
MQTT_PORT=8883

# From the EMQX Cloud console: Access Control -> Authentication
MQTT_USERNAME=gesture-pi
MQTT_PASSWORD=change-me

# Leave empty to trust the operating system's certificate store.
# Only if the TLS check fails: download the CA certificate from the EMQX console
# and put its file path here, e.g. MQTT_CA_FILE=certs/emqxsl-ca.crt
MQTT_CA_FILE=
